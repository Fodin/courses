{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@courses/platform": ["../../packages/course-platform/src/index.ts"],
      "@courses/platform/*": ["../../packages/course-platform/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/course-platform/src"]
}
